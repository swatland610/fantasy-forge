# Database
DUCKDB_PATH=data/ff_platform.duckdb

# Dagster
DAGSTER_HOME=.dagster

# dbt
DBT_PROFILES_DIR=.

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here           # dev only: instant slash command sync (vs 1hr global)
DISCORD_CHANNEL_ID=your_default_channel_here  # optional default channel for MCP posts

# Sleeper (API is public, no auth required — but useful to store your user ID)
SLEEPER_USER_ID=your_sleeper_user_id_here
